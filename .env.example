# 模型后端：gemini（AI Studio，默认）| vertex（Vertex AI，走 Cloud 结算 / 试用额度）| ollama（本机）
MODEL_BACKEND=gemini

# --- gemini：AI Studio 的 API Key（H2）---
GEMINI_API_KEY=

# --- vertex：Cloud 项目 ID；本机先执行 gcloud auth application-default login ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# gemini / vertex 共用（3.5）
GEMINI_MODEL=gemini-3.5-flash-lite
# 可选：解析单独升级
GEMINI_MODEL_STRONG=
# media_resolution 档位：low(≈280 token) / medium(≈560) / high(≈1120)
MEDIA_RES_ANALYZE=high
MEDIA_RES_SCORE=low
MEDIA_RES_AUDIT=medium
# 思考档位：minimal / low / medium / high（minimal 不可用时自动降为 low）
THINKING_LEVEL=minimal
THINKING_LEVEL_REGIONS=low

# --- ollama：本机视觉模型（需支持多图），先 ollama pull ---
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# 每批打分图数；本地模型慢或只支持单图时调小
SCORE_BATCH_SIZE=8

# 图片搜索：auto（默认：填了 BRAVE_API_KEY 用 Brave，否则 ddgs）| brave | ddgs
# 「只搜短租 / 酒店网站」依赖 site: 运算符，实测只有 Brave 支持；ddgs（Bing）只能事后过滤，结果很少
IMAGE_SEARCH=auto
# 只搜、只留短租 / 酒店网站：rental（默认）| off；每个地区查询的网站数
SITE_FILTER=rental
SITES_PER_REGION=4
# ddgs 内部引擎：bing（默认）| duckduckgo | bing,duckduckgo。DuckDuckGo 常对脚本请求返回 403
DDGS_BACKEND=bing
BRAVE_API_KEY=
SEARCH_INTERVAL_S=1.5

MAX_IMAGES=600
MAX_MODEL_CALLS_PER_RUN=300
PORT=8765
